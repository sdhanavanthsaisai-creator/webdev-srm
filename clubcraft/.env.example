# ── Supabase (dashboard → Project Settings → API) ───────────────────────────
# anon key: safe for the browser (guarded by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service key: SERVER ONLY — never prefix with NEXT_PUBLIC, never commit
SUPABASE_SERVICE_ROLE_KEY=

# ── Demo account (seeded in supabase/migration.sql) ─────────────────────────
DEMO_USER_EMAIL=demo@clubcraft.test
DEMO_USER_PASSWORD=

# ── Optional: absolute origin of the API when fronted separately ────────────
# Empty = same-origin (recommended on Vercel)
CC_API_ORIGIN=
