# .env.example
#
# COMMITTED to git. This file lists every environment variable the app needs,
# by NAME only. Placeholder values only. Never put a real key in this file.
#
# Setup: copy this file to `.env.local` AT THE APP PROJECT ROOT - the folder that
#   contains package.json, NOT this hackathon-os/ folder - and fill in the real values.
#   .env.local is gitignored and is the ONLY place real values belong.
#
#   A `.env.local` sitting inside hackathon-os/ is never read by the app, and every
#   key will silently come back `undefined`.
#
# Verify .env.local is actually ignored before you trust it:
#   git check-ignore -v .env.local
#
# Add the same variables to Vercel (Settings -> Environment Variables) for BOTH
# Production and Preview, then redeploy. Env vars only apply to new deployments.

# ── Supabase ─────────────────────────────────────────────────────────────
# Dashboard -> your project -> Settings -> API
# The URL and the anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# WARNING: bypasses all row-level security. Server-side only.
# NEVER prefix this with NEXT_PUBLIC_ or the browser will have full database access.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── AI tooling ───────────────────────────────────────────────────────────
# Optional: Context7 works without a key at a lower rate limit.
CONTEXT7_API_KEY=your_context7_api_key

# 21st.dev Magic (UI generation). Free tier is capped - watch your quota.
MAGIC_API_KEY=your_21st_dev_magic_api_key

# ── Git / CI ─────────────────────────────────────────────────────────────
# Only needed for CLI pushes or CI. GitHub Desktop + OAuth needs no token.
GITHUB_TOKEN=your_github_personal_access_token

# ── Demo account (pitch login) ───────────────────────────────────────
# A REAL seeded user used during the demo so nothing is typed live. It must
# never be a developer's personal account. Real values in .env.local + Vercel.
DEMO_USER_EMAIL=demo@clubcraft.test
DEMO_USER_PASSWORD=your_demo_password

# ── External APIs from PLAN.md section 5 ─────────────────────────────────
# Add one line per service, named EXACTLY as the provider's current docs specify.
# Do not invent variable names - a guessed name fails as a silent `undefined`.
# EXAMPLE_API_KEY=your_key_here

# ── Local development only ───────────────────────────────────────────────
# MOCK=1 makes integrations return fixture data so the demo survives an API outage.
# MOCK=0
